# Aplicacion local
NODE_ENV=development
API_PORT=4099
WEB_ORIGIN=http://localhost:5177
VITE_API_URL=http://localhost:4099/api/v1

# MySQL: crea primero la base de datos print_on_demand.
# Sustituye USUARIO y CONTRASENA; codifica caracteres especiales de la URL.
DATABASE_URL=mysql://USUARIO:CONTRASENA@127.0.0.1:3306/print_on_demand

# Sesiones y cifrado
SESSION_TTL_DAYS=14
COOKIE_SECURE=false
# Genera con: node -p "require('node:crypto').randomBytes(32).toString('hex')"
ENCRYPTION_KEY=

# Cuenta de demostracion: opcional, solo para una base local/de prueba.
SEED_EMAIL=
SEED_PASSWORD=

# Stripe Checkout: opcional; usa claves y webhook del mismo entorno.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STOREFRONT_TENANT_ID=

# Printful: opcional; la fabricacion propia es el modo predeterminado.
PRINTFUL_API_BASE_URL=https://api.printful.com
PRINTFUL_ACCESS_TOKEN=

# UPS cotizaciones: opcional. Para guias se requieren tambien los datos
# completos del remitente y las dimensiones/peso reales del paquete.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_API_BASE_URL=https://onlinetools.ups.com
UPS_SHIP_FROM_POSTAL_CODE=
UPS_SHIP_FROM_COUNTRY_CODE=MX
UPS_SHIP_FROM_NAME=
UPS_SHIP_FROM_PHONE=
UPS_SHIP_FROM_ADDRESS_LINE1=
UPS_SHIP_FROM_ADDRESS_LINE2=
UPS_SHIP_FROM_CITY=
UPS_SHIP_FROM_STATE=
UPS_PACKAGE_LENGTH_CM=30
UPS_PACKAGE_WIDTH_CM=20
UPS_PACKAGE_HEIGHT_CM=5
UPS_PACKAGE_WEIGHT_KG=0.5
