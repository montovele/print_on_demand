generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
}

enum MemberRole {
  owner
  admin
  editor
  viewer
  customer
}

enum ProductStatus {
  draft
  processing
  ready
  published
  sync_error
  archived
}

enum OrderStatus {
  received
  validation_pending
  awaiting_approval
  submitted
  accepted
  in_production
  shipped
  delivered
  cancel_requested
  cancelled
  failed
  action_required
}

enum PaymentStatus {
  not_required
  pending
  paid
  failed
  refunded
}

enum SupportTicketPriority {
  low
  normal
  high
  urgent
}

enum SupportTicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

enum SupportTicketActivityType {
  created
  comment
  status_changed
  priority_changed
}

enum FulfillmentMode {
  in_house
  printful
}

enum MachineStatus {
  active
  maintenance
  inactive
}

enum ProductionJobStatus {
  queued
  prepress
  ready
  in_production
  quality_check
  packed
  shipped
  completed
  blocked
  cancelled
}

enum StockMovementType {
  receipt
  adjustment
  consumption
  return
}

model User {
  id              String                 @id @default(cuid())
  email           String                 @unique @db.VarChar(191)
  passwordHash    String                 @db.VarChar(255)
  name            String                 @db.VarChar(160)
  memberships     TenantMembership[]
  customerAccount CustomerAccount?
  sessions        AuthSession[]
  supportComments SupportTicketComment[] @relation("SupportCommentAuthor")
  customerOrders  Order[]                @relation("OrderCustomer")
  uploadedArtwork ProductArtworkAsset[]  @relation("ArtworkUploader")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model CustomerAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Tenant {
  id               String                @id @default(cuid())
  name             String                @db.VarChar(160)
  slug             String                @unique @db.VarChar(191)
  status           TenantStatus          @default(active)
  memberships      TenantMembership[]
  products         Product[]
  orders           Order[]
  providerAccounts ProviderAccount[]
  machines         Machine[]
  materials        Material[]
  productionJobs   ProductionJob[]
  stockMovements   StockMovement[]
  artworkAssets    ProductArtworkAsset[]
  shipments        Shipment[]
  sessions         AuthSession[]
  supportTickets   SupportTicket[]
  shippingFlatRate Decimal               @default(0) @db.Decimal(12, 2)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model TenantMembership {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      MemberRole @default(owner)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  csrfToken String   @db.VarChar(64)
  userId    String
  tenantId  String?
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([tenantId])
  @@index([expiresAt])
}

model Product {
  id                   String                       @id @default(cuid())
  tenantId             String
  name                 String                       @db.VarChar(191)
  description          String?                      @db.Text
  status               ProductStatus                @default(draft)
  providerCode         String?                      @db.VarChar(64)
  externalProductId    String?                      @db.VarChar(191)
  fulfillmentMode      FulfillmentMode              @default(in_house)
  productType          String                       @default("custom") @db.VarChar(50)
  productionMethod     String?                      @db.VarChar(100)
  productionMinutes    Int?                         @db.UnsignedInt
  manufacturingNotes   String?                      @db.Text
  designConfig         Json?
  artworkAssetId       String?                      @unique
  baseCost             Decimal                      @default(0) @db.Decimal(12, 2)
  salePrice            Decimal                      @default(0) @db.Decimal(12, 2)
  currency             String                       @default("MXN") @db.Char(3)
  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants             ProductVariant[]
  artworkAsset         ProductArtworkAsset?         @relation(fields: [artworkAssetId], references: [id], onDelete: SetNull)
  materialRequirements ProductMaterialRequirement[]
  productionJobs       ProductionJob[]
  orderItems           OrderItem[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@unique([tenantId, providerCode, externalProductId])
  @@index([tenantId, status, updatedAt])
}

model ProductArtworkAsset {
  id               String     @id @db.Char(36)
  tenantId         String
  uploadedByUserId String?
  storageKey       String     @unique @db.VarChar(100)
  mimeType         String     @db.VarChar(40)
  fileSize         Int        @db.UnsignedInt
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy       User?      @relation("ArtworkUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  product          Product?
  orderItem        OrderItem?
  createdAt        DateTime   @default(now())

  @@index([tenantId, createdAt])
  @@index([uploadedByUserId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  externalVariantId String?  @db.VarChar(191)
  sku               String?  @db.VarChar(100)
  name              String   @db.VarChar(191)
  size              String?  @db.VarChar(80)
  color             String?  @db.VarChar(80)
  providerCost      Decimal  @default(0) @db.Decimal(12, 2)
  salePrice         Decimal  @default(0) @db.Decimal(12, 2)
  currency          String   @default("MXN") @db.Char(3)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productId])
}

model Order {
  id                      String          @id @default(cuid())
  tenantId                String
  customerUserId          String?
  storeName               String          @default("Manual") @db.VarChar(120)
  externalOrderId         String?         @db.VarChar(191)
  orderNumber             String          @db.VarChar(100)
  customerName            String          @db.VarChar(191)
  customerEmail           String?         @db.VarChar(191)
  shippingAddress         Json?
  shippingTotal           Decimal         @default(0) @db.Decimal(12, 2)
  currency                String          @default("MXN") @db.Char(3)
  customerTotal           Decimal         @default(0) @db.Decimal(12, 2)
  providerTotal           Decimal?        @db.Decimal(12, 2)
  status                  OrderStatus     @default(received)
  paymentStatus           PaymentStatus   @default(not_required)
  stripeCheckoutSessionId String?         @unique @db.VarChar(191)
  stripePaymentIntentId   String?         @db.VarChar(191)
  paidAt                  DateTime?
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                User?           @relation("OrderCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  productionJobs          ProductionJob[]
  shipments               Shipment[]
  supportTickets          SupportTicket[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([tenantId, storeName, externalOrderId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerUserId, createdAt])
  @@index([tenantId, paymentStatus, createdAt])
}

model SupportTicket {
  id              String                 @id @default(cuid())
  tenantId        String
  orderId         String?
  productionJobId String?
  orderNumber     String?                @db.VarChar(100)
  customerName    String                 @db.VarChar(191)
  subject         String                 @db.VarChar(160)
  description     String                 @db.Text
  priority        SupportTicketPriority  @default(normal)
  status          SupportTicketStatus    @default(open)
  createdByUserId String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productionJob   ProductionJob?         @relation(fields: [productionJobId], references: [id], onDelete: SetNull)
  comments        SupportTicketComment[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([tenantId, status, priority, createdAt])
  @@index([orderId])
  @@index([productionJobId])
  @@index([tenantId, firstResponseAt, resolvedAt])
}

model SupportTicketComment {
  id               String                    @id @default(cuid())
  ticketId         String
  authorUserId     String?
  authorName       String                    @db.VarChar(191)
  authorRole       MemberRole?
  activityType     SupportTicketActivityType @default(comment)
  previousStatus   SupportTicketStatus?
  newStatus        SupportTicketStatus?
  previousPriority SupportTicketPriority?
  newPriority      SupportTicketPriority?
  body             String                    @db.Text
  ticket           SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author           User?                     @relation("SupportCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                  @default(now())

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
}

model OrderItem {
  id                String               @id @default(cuid())
  orderId           String
  productId         String?
  productName       String               @db.VarChar(191)
  variantName       String?              @db.VarChar(191)
  quantity          Int
  unitSalePrice     Decimal              @db.Decimal(12, 2)
  unitProviderCost  Decimal?             @db.Decimal(12, 2)
  designConfig      Json?
  printInstructions String?              @db.Text
  artworkAssetId    String?              @unique @db.Char(36)
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  artworkAsset      ProductArtworkAsset? @relation(fields: [artworkAssetId], references: [id], onDelete: SetNull)
  productionJob     ProductionJob?

  @@index([orderId])
}

model ProviderAccount {
  id                   String   @id @default(cuid())
  tenantId             String
  providerCode         String   @db.VarChar(64)
  displayName          String   @db.VarChar(160)
  encryptedAccessToken String   @db.Text
  connectionStatus     String   @default("connected") @db.VarChar(40)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, providerCode])
  @@index([tenantId])
}

model Machine {
  id               String          @id @default(cuid())
  tenantId         String
  name             String          @db.VarChar(160)
  technology       String          @db.VarChar(100)
  status           MachineStatus   @default(active)
  location         String?         @db.VarChar(191)
  hourlyRate       Decimal         @default(0) @db.Decimal(12, 2)
  maintenanceDueAt DateTime?
  notes            String?         @db.Text
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productionJobs   ProductionJob[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, status])
}

model Material {
  id                  String                       @id @default(cuid())
  tenantId            String
  sku                 String                       @db.VarChar(100)
  name                String                       @db.VarChar(160)
  unit                String                       @db.VarChar(40)
  onHand              Decimal                      @default(0) @db.Decimal(14, 3)
  reorderPoint        Decimal                      @default(0) @db.Decimal(14, 3)
  unitCost            Decimal                      @default(0) @db.Decimal(12, 4)
  currency            String                       @default("MXN") @db.Char(3)
  isActive            Boolean                      @default(true)
  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productRequirements ProductMaterialRequirement[]
  movements           StockMovement[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, isActive, name])
}

model ProductMaterialRequirement {
  id         String   @id @default(cuid())
  productId  String
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([productId, materialId])
  @@index([materialId])
}

model ProductionJob {
  id                  String                 @id @default(cuid())
  tenantId            String
  orderId             String
  orderItemId         String                 @unique
  productId           String
  machineId           String?
  code                String                 @db.VarChar(100)
  status              ProductionJobStatus    @default(queued)
  quantity            Int
  priority            Int                    @default(3) @db.UnsignedTinyInt
  productionMethod    String?                @db.VarChar(100)
  notes               String?                @db.Text
  blockedReason       String?                @db.Text
  estimatedMinutes    Int?                   @db.UnsignedInt
  scheduledAt         DateTime?
  startedAt           DateTime?
  materialsConsumedAt DateTime?
  completedAt         DateTime?
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order               Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem           OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product             Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  machine             Machine?               @relation(fields: [machineId], references: [id], onDelete: SetNull)
  history             ProductionJobHistory[]
  stockMovements      StockMovement[]
  supportTickets      SupportTicket[]
  shipment            Shipment?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status, priority, createdAt])
  @@index([machineId, status])
  @@index([orderId])
}

model ProductionJobHistory {
  id          String               @id @default(cuid())
  jobId       String
  fromStatus  ProductionJobStatus?
  toStatus    ProductionJobStatus
  note        String?              @db.Text
  actorUserId String
  job         ProductionJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())

  @@index([jobId, createdAt])
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  materialId  String
  jobId       String?
  type        StockMovementType
  quantity    Decimal           @db.Decimal(14, 3)
  note        String?           @db.VarChar(255)
  actorUserId String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  material    Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  job         ProductionJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([tenantId, createdAt])
  @@index([materialId, createdAt])
  @@index([jobId])
}

model Shipment {
  id                              String        @id @default(cuid())
  tenantId                        String
  orderId                         String
  productionJobId                 String        @unique
  carrier                         String        @db.VarChar(100)
  trackingNumber                  String?       @db.VarChar(191)
  trackingUrl                     String?       @db.VarChar(2048)
  status                          String        @default("shipped") @db.VarChar(40)
  upsShipmentIdentificationNumber String?       @db.VarChar(191)
  upsServiceCode                  String?       @db.VarChar(40)
  upsServiceName                  String?       @db.VarChar(120)
  labelStorageKeys                Json?
  packageTrackingNumbers          Json?
  trackingStatus                  String?       @db.VarChar(191)
  trackingUpdatedAt               DateTime?
  shippedAt                       DateTime      @default(now())
  deliveredAt                     DateTime?
  notes                           String?       @db.Text
  tenant                          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order                           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productionJob                   ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Cascade)
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt

  @@unique([tenantId, carrier, trackingNumber])
  @@index([tenantId, shippedAt])
}
