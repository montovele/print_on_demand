# ============================================================
# SSAXXON E-COMMERCE
# ============================================================

server {
    listen 80;
    listen [::]:80;

    server_name ssaxxon.com www.ssaxxon.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name ssaxxon.com www.ssaxxon.com;

    root /var/www/ssaxxon/ssaxxon_ecommerce/dist;
    index index.html;

    ssl_certificate     /etc/ssl/cloudflare/ssaxxon-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/ssaxxon-origin.key;

    location / {
        try_files $uri $uri/ /index.html;
    }
}


