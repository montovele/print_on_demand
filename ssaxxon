# ============================================================
# E-COMMERCE DEMO - WORDPRESS / WOOCOMMERCE
# ============================================================

server {
    listen 80;
    listen [::]:80;

    server_name ecommercedemo.ssaxxon.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name ecommercedemo.ssaxxon.com;

    root /var/www/ssaxxon/wordpress;
    index index.php index.html;

    ssl_certificate     /etc/ssl/cloudflare/ssaxxon-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/ssaxxon-origin.key;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ /\.ht {
        deny all;
    }
}